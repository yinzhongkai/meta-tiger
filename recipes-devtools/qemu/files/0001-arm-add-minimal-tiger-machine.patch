From 7ed31149ac01a9d6bb3a682b9d768936c4315ed3 Mon Sep 17 00:00:00 2001
From: "zhongkai.yin" <yinzhongkai@yeah.net>
Date: Thu, 15 Oct 2026 23:38:43 +0800
Subject: [PATCH] T-016: arm: add minimal Tiger A53 teaching machine

Implement the approved single-core ROM/RAM/PL011 firmware contract.
Use the ARM loader firmware reset path once, reject unsupported inputs,
and register ROM with a NULL migration owner in QEMU 8.2.7.

Upstream-Status: Inappropriate [project-specific teaching platform]
---
 hw/arm/Kconfig     |   6 ++
 hw/arm/meson.build |   2 +
 hw/arm/tiger.c     | 161 +++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 169 insertions(+)
 create mode 100644 hw/arm/tiger.c

diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index 3ada335a2..b6e6bb619 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -679,3 +679,9 @@ config ARMSSE
     select UNIMP
     select SSE_COUNTER
     select SSE_TIMER
+
+config TIGER
+    bool
+    default y
+    depends on TCG && AARCH64
+    select PL011
diff --git a/hw/arm/meson.build b/hw/arm/meson.build
index 68245d3ad..f72e8c1c0 100644
--- a/hw/arm/meson.build
+++ b/hw/arm/meson.build
@@ -72,3 +72,5 @@ system_ss.add(when: 'CONFIG_RASPI', if_true: files('bcm2835_peripherals.c'))
 system_ss.add(when: 'CONFIG_TOSA', if_true: files('tosa.c'))
 
 hw_arch += {'arm': arm_ss}
+
+arm_ss.add(when: 'CONFIG_TIGER', if_true: files('tiger.c'))
diff --git a/hw/arm/tiger.c b/hw/arm/tiger.c
new file mode 100644
index 000000000..176c061b1
--- /dev/null
+++ b/hw/arm/tiger.c
@@ -0,0 +1,161 @@
+/*
+ * Minimal Tiger teaching board: QEMU 8.2.7, A-005 v0.2.
+ * Copyright (c) 2026 Tiger contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qemu/datadir.h"
+#include "qapi/error.h"
+#include "exec/address-spaces.h"
+#include "hw/arm/boot.h"
+#include "hw/boards.h"
+#include "hw/char/pl011.h"
+#include "hw/clock.h"
+#include "hw/loader.h"
+#include "hw/qdev-clock.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "sysemu/sysemu.h"
+#include "sysemu/tcg.h"
+#include "target/arm/cpu.h"
+
+#define TYPE_TIGER_MACHINE MACHINE_TYPE_NAME("tiger")
+OBJECT_DECLARE_SIMPLE_TYPE(TigerMachineState, TIGER_MACHINE)
+
+#define TIGER_ROM_SIZE MiB
+#define TIGER_RAM_BASE 0x40000000ULL
+#define TIGER_RAM_SIZE GiB
+#define TIGER_UART_BASE 0x09000000ULL
+#define TIGER_CLOCK_HZ 24000000
+
+struct TigerMachineState {
+    MachineState parent_obj;
+    MemoryRegion rom;
+    Clock *uartclk;
+    struct arm_boot_info bootinfo;
+};
+
+static void tiger_init(MachineState *ms)
+{
+    TigerMachineState *s = TIGER_MACHINE(ms);
+    MemoryRegion *sysmem = get_system_memory();
+    ARMCPU *cpu;
+    DeviceState *uart;
+    g_autofree char *bios = NULL;
+    ssize_t loaded;
+
+    if (!tcg_enabled()) {
+        error_report("tiger: only the TCG accelerator is supported");
+        exit(1);
+    }
+    if (strcmp(ms->cpu_type, ARM_CPU_TYPE_NAME("cortex-a53"))) {
+        error_report("tiger: only cortex-a53 is supported");
+        exit(1);
+    }
+    if (ms->smp.cpus != 1 || ms->smp.max_cpus != 1) {
+        error_report("tiger: exactly one CPU is required");
+        exit(1);
+    }
+    if (ms->ram_size != TIGER_RAM_SIZE || ms->maxram_size != ms->ram_size) {
+        error_report("tiger: RAM must be exactly 1024 MiB without hotplug");
+        exit(1);
+    }
+    if (ms->kernel_filename || ms->initrd_filename || ms->dtb) {
+        error_report("tiger: kernel, initrd and DTB inputs are unsupported");
+        exit(1);
+    }
+    if (!ms->firmware) {
+        error_report("tiger: a non-empty raw -bios image is required");
+        exit(1);
+    }
+    bios = qemu_find_file(QEMU_FILE_TYPE_BIOS, ms->firmware);
+    if (!bios) {
+        error_report("tiger: cannot find BIOS '%s'", ms->firmware);
+        exit(1);
+    }
+
+    /* Migration registration accepts only a DeviceState or NULL owner. */
+    memory_region_init_rom(&s->rom, NULL, "tiger.rom",
+                           TIGER_ROM_SIZE, &error_fatal);
+    memory_region_add_subregion(sysmem, 0, &s->rom);
+    memory_region_add_subregion(sysmem, TIGER_RAM_BASE, ms->ram);
+    loaded = load_image_mr(bios, &s->rom);
+    if (loaded <= 0) {
+        error_report("tiger: BIOS must be readable raw data with "
+                     "0 < size <= 1 MiB: '%s'", bios);
+        exit(1);
+    }
+
+    cpu = ARM_CPU(object_new(ms->cpu_type));
+    object_property_set_bool(OBJECT(cpu), "has_el2", true, &error_fatal);
+    object_property_set_bool(OBJECT(cpu), "has_el3", true, &error_fatal);
+    object_property_set_bool(OBJECT(cpu), "start-powered-off", false,
+                             &error_fatal);
+    object_property_set_int(OBJECT(cpu), "rvbar", 0, &error_fatal);
+    object_property_set_int(OBJECT(cpu), "cntfrq", TIGER_CLOCK_HZ,
+                            &error_fatal);
+    object_property_set_int(OBJECT(cpu), "psci-conduit",
+                            QEMU_PSCI_CONDUIT_DISABLED, &error_fatal);
+    object_property_set_link(OBJECT(cpu), "memory", OBJECT(sysmem),
+                             &error_fatal);
+    object_property_set_link(OBJECT(cpu), "secure-memory", OBJECT(sysmem),
+                             &error_fatal);
+    qdev_realize(DEVICE(cpu), NULL, &error_fatal);
+    object_unref(OBJECT(cpu));
+
+    s->uartclk = clock_new(OBJECT(ms), "uartclk");
+    clock_set_hz(s->uartclk, TIGER_CLOCK_HZ);
+    uart = qdev_new(TYPE_PL011);
+    qdev_prop_set_chr(uart, "chardev", serial_hd(0));
+    qdev_connect_clock_in(uart, "clk", s->uartclk);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(uart), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(uart), 0, TIGER_UART_BASE);
+    /* Polling only: no GIC, UART IRQ or timer PPI connections. */
+
+    s->bootinfo.ram_size = TIGER_RAM_SIZE;
+    s->bootinfo.loader_start = TIGER_RAM_BASE;
+    s->bootinfo.firmware_loaded = true;
+    s->bootinfo.is_linux = false;
+    s->bootinfo.psci_conduit = QEMU_PSCI_CONDUIT_DISABLED;
+    /*
+     * Registers CPU reset once. With no kernel/DTB, env->boot_info remains
+     * NULL, so reset uses rvbar rather than a direct-kernel entry.
+     * bootinfo belongs to this machine; never register again on reset.
+     */
+    arm_load_kernel(cpu, ms, &s->bootinfo);
+}
+
+static void tiger_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    static const char * const valid_cpus[] = {
+        ARM_CPU_TYPE_NAME("cortex-a53"), NULL
+    };
+
+    mc->desc = "Tiger minimal single-core A53 teaching board";
+    mc->init = tiger_init;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a53");
+    mc->valid_cpu_types = valid_cpus;
+    mc->min_cpus = 1;
+    mc->default_cpus = 1;
+    mc->max_cpus = 1;
+    mc->default_ram_size = TIGER_RAM_SIZE;
+    mc->default_ram_id = "tiger.ram";
+    mc->no_cdrom = true;
+    mc->no_floppy = true;
+    mc->no_parallel = true;
+}
+
+static const TypeInfo tiger_machine_type = {
+    .name = TYPE_TIGER_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(TigerMachineState),
+    .class_init = tiger_class_init,
+};
+
+static void tiger_register_types(void)
+{
+    type_register_static(&tiger_machine_type);
+}
+type_init(tiger_register_types)
-- 
2.43.0

